---
import { siteConfig } from '../config/site';

const serviceOptions = [
  'Residential Tank Cleaning',
  'Commercial Tank Cleaning',
  'Overhead Tank Cleaning',
  'Underground Sump Cleaning',
  'Sump & Sintex Tank Cleaning',
  'Industrial Tank Cleaning',
];
---

<!-- 30% Scroll Triggered Popup Lead Modal -->
<div
  id="scroll-popup-modal"
  class="fixed inset-0 z-[100] hidden items-center justify-center p-4 sm:p-6 bg-slate-950/75 backdrop-blur-sm transition-opacity duration-300 opacity-0"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <div
    id="scroll-popup-content"
    class="relative w-full max-w-md bg-white rounded-3xl shadow-2xl border border-slate-200 overflow-hidden transform transition-all duration-300 scale-95"
  >
    <!-- Top Decorative Bar -->
    <div class="bg-gradient-to-r from-[#0088cc] to-sky-500 p-5 sm:p-6 text-white text-left relative">
      <button
        type="button"
        id="close-popup-btn"
        class="absolute top-4 right-4 w-9 h-9 flex items-center justify-center rounded-full bg-white/20 hover:bg-white/30 text-white transition-colors focus:outline-none"
        aria-label="Close quote popup"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-white/20 text-sky-100 text-xs font-bold uppercase tracking-wider mb-2">
        <span>⚡ Quick Quote</span>
      </div>
      <h3 id="modal-title" class="text-base sm:text-lg font-black text-white leading-tight truncate">
        Book Tank Cleaning in Hyderabad
      </h3>
      <p class="text-xs text-sky-100 mt-1 font-medium truncate">
        Get instant response & transparent pricing.
      </p>
    </div>

    <!-- Popup Form -->
    <form id="popup-quote-form" class="p-6 space-y-4 text-left">
      <!-- 1. Name Field -->
      <div>
        <label for="popup-name" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
          Your Name <span class="text-rose-500">*</span>
        </label>
        <input
          type="text"
          id="popup-name"
          name="name"
          required
          placeholder="e.g. Ramesh Kumar"
          class="w-full px-4 py-3 rounded-xl border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#0088cc] focus:border-transparent text-sm transition-all"
        />
      </div>

      <!-- 2. Mobile Number Field -->
      <div>
        <label for="popup-phone" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
          Mobile Number <span class="text-rose-500">*</span>
        </label>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400 text-sm font-bold">
            +91
          </span>
          <input
            type="tel"
            id="popup-phone"
            name="phone"
            required
            pattern="[0-9]{10}"
            maxlength="10"
            placeholder="98765 43210"
            class="w-full pl-12 pr-4 py-3 rounded-xl border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#0088cc] focus:border-transparent text-sm transition-all"
          />
        </div>
      </div>

      <!-- 3. Service Selection -->
      <div>
        <label for="popup-service" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
          Required Service <span class="text-rose-500">*</span>
        </label>
        <select
          id="popup-service"
          name="service"
          required
          class="w-full px-4 py-3 rounded-xl border border-slate-300 text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-[#0088cc] focus:border-transparent text-sm transition-all"
        >
          {serviceOptions.map((svc, idx) => (
            <option value={svc} selected={idx === 0}>{svc}</option>
          ))}
        </select>
      </div>

      <!-- 4. CTA Button -->
      <div class="pt-2">
        <button
          type="submit"
          class="w-full inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#20bd5a] text-white font-black text-base py-3.5 px-6 rounded-xl shadow-lg shadow-emerald-600/30 transition-all active:scale-[0.98]"
        >
          <svg class="w-5 h-5 text-white shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.159.57 4.184 1.564 5.938l-1.564 5.718 5.864-1.538c1.701.927 3.652 1.458 5.727 1.458 6.627 0 12-5.373 12-12 0-6.627-5.373-12-12-12z"/>
          </svg>
          <span>Get Instant Quote</span>
        </button>
      </div>

      <!-- Quick Call Secondary Link -->
      <div class="text-center pt-1">
        <p class="text-xs text-slate-500">
          Or call directly: <a href={siteConfig.phone.tel} class="font-bold text-[#0088cc] hover:underline">{siteConfig.phone.display}</a>
        </p>
      </div>
    </form>
  </div>
</div>

<script is:inline>
  (function() {
    var modal = document.getElementById('scroll-popup-modal');
    var content = document.getElementById('scroll-popup-content');
    var closeBtn = document.getElementById('close-popup-btn');
    var form = document.getElementById('popup-quote-form');

    if (!modal || !content || !closeBtn) return;

    var isShown = false;

    function showModal() {
      if (isShown) return;
      isShown = true;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      setTimeout(function() {
        modal.classList.remove('opacity-0');
        modal.classList.add('opacity-100');
        content.classList.remove('scale-95');
        content.classList.add('scale-100');
      }, 20);
    }

    function closeModal() {
      modal.classList.remove('opacity-100');
      modal.classList.add('opacity-0');
      content.classList.remove('scale-100');
      content.classList.add('scale-95');
      setTimeout(function() {
        modal.classList.remove('flex');
        modal.classList.add('hidden');
      }, 300);
    }

    function checkScroll() {
      if (isShown) return;
      var docEl = document.documentElement;
      var body = document.body;
      var scrollTop = window.pageYOffset || docEl.scrollTop || body.scrollTop || 0;
      var scrollHeight = Math.max(docEl.scrollHeight, body.scrollHeight) - window.innerHeight;

      // Trigger strictly after scrolling past 30% of content height
      if (scrollHeight > 50 && (scrollTop / scrollHeight >= 0.30)) {
        showModal();
        window.removeEventListener('scroll', checkScroll);
      }
    }

    window.addEventListener('scroll', checkScroll, { passive: true });

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', function(e) {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var nameInput = document.getElementById('popup-name');
        var phoneInput = document.getElementById('popup-phone');
        var serviceSelect = document.getElementById('popup-service');

        var name = (nameInput && nameInput.value) ? nameInput.value.trim() : '';
        var phone = (phoneInput && phoneInput.value) ? phoneInput.value.trim() : '';
        var service = (serviceSelect && serviceSelect.value) ? serviceSelect.value : 'Water Tank Cleaning';

        var msg = 'Hello Vijaya Water Tank Cleaning Services, I would like to request a quote:%0A%0A• *Name:* ' + encodeURIComponent(name) + '%0A• *Mobile:* ' + encodeURIComponent(phone) + '%0A• *Service:* ' + encodeURIComponent(service) + '%0A• *Location:* Champapet / Nearby';

        closeModal();
        window.open('https://wa.me/918247735114?text=' + msg, '_blank');
      });
    }
  })();
</script>
