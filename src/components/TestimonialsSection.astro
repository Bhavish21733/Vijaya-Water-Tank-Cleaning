---
import { testimonials } from '../data/testimonials';
import { siteConfig } from '../config/site';

interface Props {
  title?: string;
  subtitle?: string;
  class?: string;
}

const {
  title = "What Our Customers Say in Champapet",
  subtitle = "Feedback from residential homeowners, villa residents, and building managers in Champapet and South Hyderabad.",
  class: className = '',
} = Astro.props;
---

<section class={`py-14 sm:py-16 bg-slate-50 border-b border-slate-200/80 ${className}`}>
  <div class="container-custom">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8 text-left">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-bold uppercase tracking-wider mb-2">
          <svg class="w-3.5 h-3.5 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          <span>Verified Local Reviews</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          {title}
        </h2>
        <p class="text-sm text-slate-600 mt-1 leading-relaxed">
          {subtitle}
        </p>
      </div>

      <!-- Navigation Arrows & Google Badge -->
      <div class="flex items-center gap-3">
        <a
          href={siteConfig.googleMaps.listingUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white border border-slate-200 shadow-sm text-xs font-bold text-slate-800 hover:border-sky-300 transition-all"
        >
          <span class="w-5 h-5 rounded bg-slate-900 text-white flex items-center justify-center text-[10px]">G</span>
          <span>23 Reviews (5.0 ★)</span>
        </a>

        <div class="flex items-center gap-2">
          <button
            type="button"
            id="testimonial-prev"
            class="w-9 h-9 rounded-full bg-white border border-slate-200 text-slate-700 hover:bg-sky-600 hover:text-white hover:border-sky-600 flex items-center justify-center transition-colors shadow-sm focus:outline-none"
            aria-label="Previous Testimonials"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button
            type="button"
            id="testimonial-next"
            class="w-9 h-9 rounded-full bg-white border border-slate-200 text-slate-700 hover:bg-sky-600 hover:text-white hover:border-sky-600 flex items-center justify-center transition-colors shadow-sm focus:outline-none"
            aria-label="Next Testimonials"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Carousel Track Container -->
    <div class="relative overflow-hidden">
      <div
        id="testimonials-track"
        class="flex gap-4 sm:gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-4 no-scrollbar"
        style="scrollbar-width: none; -ms-overflow-style: none;"
      >
        {testimonials.map((t) => (
          <div class="w-full sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] shrink-0 snap-start bg-white p-5 sm:p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between text-left">
            <div>
              <!-- Rating & Tag -->
              <div class="flex items-center justify-between gap-2 mb-3">
                <div class="flex items-center gap-0.5 text-amber-400 text-xs">
                  {[...Array(t.rating)].map(() => (
                    <span>★</span>
                  ))}
                </div>
                <span class="px-2 py-0.5 rounded bg-sky-50 text-sky-700 font-bold text-[10px] border border-sky-100 truncate max-w-[170px]">
                  {t.serviceType}
                </span>
              </div>

              <!-- Comment -->
              <p class="text-xs sm:text-sm text-slate-700 leading-relaxed italic">
                "{t.comment}"
              </p>
            </div>

            <!-- Author Info -->
            <div class="mt-5 pt-3 border-t border-slate-100 flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-sky-600 text-white font-bold flex items-center justify-center text-xs shrink-0">
                {t.author.charAt(0)}
              </div>
              <div class="min-w-0">
                <p class="font-bold text-slate-900 text-xs truncate">{t.author}</p>
                <p class="text-[11px] text-slate-500 truncate">{t.location}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<script>
  const track = document.getElementById('testimonials-track');
  const prevBtn = document.getElementById('testimonial-prev');
  const nextBtn = document.getElementById('testimonial-next');

  if (track && prevBtn && nextBtn) {
    const getScrollAmount = () => {
      const card = track.querySelector('div');
      return card ? card.offsetWidth + 24 : 320;
    };

    prevBtn.addEventListener('click', () => {
      track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', () => {
      track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
    });
  }
</script>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>
