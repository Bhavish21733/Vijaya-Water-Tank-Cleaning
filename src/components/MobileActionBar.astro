---
import { siteConfig } from '../config/site';
---

<aside 
  id="mobile-action-bar"
  class="md:hidden fixed bottom-0 inset-x-0 z-50 bg-white/95 backdrop-blur-md border-t border-slate-200 p-2.5 sm:p-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] shadow-[0_-4px_25px_rgba(0,0,0,0.12)] transition-transform duration-200"
  aria-label="Quick Actions"
>
  <div class="grid grid-cols-2 gap-3 max-w-md mx-auto">
    <!-- Call Now Button (High contrast solid blue, white icon & bold text) -->
    <a
      href={siteConfig.phone.tel}
      class="flex items-center justify-center gap-2 bg-[#0088cc] hover:bg-[#0077b5] text-white font-black text-sm py-3 px-3 rounded-xl shadow-md transition-all active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0088cc]"
      aria-label={`Call Vijaya Water Tank Cleaning at ${siteConfig.phone.display}`}
    >
      <svg class="w-4 h-4 text-white shrink-0" fill="currentColor" viewBox="0 0 20 20">
        <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"/>
      </svg>
      <span class="truncate text-white font-extrabold tracking-wide">Call Now</span>
    </a>

    <!-- WhatsApp Button (High contrast solid emerald green, white icon & bold text) -->
    <a
      href={siteConfig.phone.whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center gap-1.5 bg-[#25D366] hover:bg-[#20bd5a] text-white font-black text-sm py-3 px-3 rounded-xl shadow-md transition-all active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#25D366]"
      aria-label="Chat on WhatsApp with Vijaya Water Tank Cleaning"
    >
      <svg class="w-4 h-4 text-white shrink-0" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.159.57 4.184 1.564 5.938l-1.564 5.718 5.864-1.538c1.701.927 3.652 1.458 5.727 1.458 6.627 0 12-5.373 12-12 0-6.627-5.373-12-12-12z"/>
      </svg>
      <span class="truncate text-white font-extrabold tracking-wide">WhatsApp</span>
    </a>
  </div>
</aside>
