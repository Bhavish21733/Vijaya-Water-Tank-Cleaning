---
import { siteConfig } from '../config/site';

interface Props {
  limit?: number;
  showIntro?: boolean;
  layout?: 'grid' | 'carousel';
}

const { limit, showIntro = false, layout = 'grid' } = Astro.props;

const items = limit ? siteConfig.services.slice(0, limit) : siteConfig.services;
---

<div class="gallery-component">
  {showIntro && (
    <div class="mb-8 max-w-2xl">
      <p class="text-sm text-slate-600 leading-relaxed">
        Browse photographs of domestic, commercial, overhead, underground, industrial, and Sintex water storage cleaning setups.
      </p>
    </div>
  )}

  {layout === 'carousel' ? (
    <div>
      <!-- Navigation Arrows & Controls -->
      <div class="flex items-center justify-between gap-4 mb-4">
        <div class="flex items-center gap-2 text-xs font-semibold text-slate-500">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Live Setup Showcase</span>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            id="gallery-prev"
            class="w-9 h-9 rounded-full bg-white border border-slate-200 text-slate-700 hover:bg-sky-600 hover:text-white hover:border-sky-600 flex items-center justify-center transition-colors shadow-sm focus:outline-none"
            aria-label="Previous image"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button
            type="button"
            id="gallery-next"
            class="w-9 h-9 rounded-full bg-white border border-slate-200 text-slate-700 hover:bg-sky-600 hover:text-white hover:border-sky-600 flex items-center justify-center transition-colors shadow-sm focus:outline-none"
            aria-label="Next image"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Auto-Scrolling Carousel Track Container -->
      <div class="relative overflow-hidden group/track rounded-2xl">
        <div
          id="gallery-track"
          class="flex gap-4 sm:gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory py-2 no-scrollbar"
          style="scrollbar-width: none; -ms-overflow-style: none;"
        >
          {items.map((item, index) => (
            <div class="w-full sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] shrink-0 snap-start">
              <button
                type="button"
                class="gallery-trigger group block relative w-full h-64 sm:h-72 rounded-2xl overflow-hidden bg-slate-900 text-left focus:outline-none focus-visible:ring-4 focus-visible:ring-sky-500 shadow-card hover:shadow-card-hover transition-all duration-300"
                data-index={index}
                data-image={item.image}
                data-title={item.title}
                data-alt={item.imageAlt}
                aria-label={`Open high-resolution view of ${item.title}`}
              >
                <img
                  src={item.image}
                  alt={item.imageAlt}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-black/20 to-transparent opacity-80 group-hover:opacity-60 transition-opacity"></div>
                
                <!-- Zoom Icon on Hover -->
                <div class="absolute top-3 right-3 bg-slate-900/80 backdrop-blur-sm text-white p-2 rounded-xl opacity-0 group-hover:opacity-100 group-focus:opacity-100 transition-opacity shadow-sm">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                  </svg>
                </div>

                <!-- Title Overlay on Bottom of Image -->
                <div class="absolute bottom-4 left-4 right-4 text-white">
                  <span class="inline-block text-xs font-bold text-white bg-sky-600/90 px-3 py-1.5 rounded-lg backdrop-blur-sm shadow-md">
                    {item.title}
                  </span>
                </div>
              </button>
            </div>
          ))}
        </div>
      </div>
    </div>
  ) : (
    <!-- Open Static Grid Layout: All Images Visible at Once in 3-Column Responsive Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {items.map((item, index) => (
        <div class="w-full">
          <button
            type="button"
            class="gallery-trigger group block relative w-full h-64 sm:h-72 rounded-2xl overflow-hidden bg-slate-900 text-left focus:outline-none focus-visible:ring-4 focus-visible:ring-sky-500 shadow-card hover:shadow-card-hover transition-all duration-300"
            data-index={index}
            data-image={item.image}
            data-title={item.title}
            data-alt={item.imageAlt}
            aria-label={`Open high-resolution view of ${item.title}`}
          >
            <img
              src={item.image}
              alt={item.imageAlt}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-black/20 to-transparent opacity-80 group-hover:opacity-60 transition-opacity"></div>
            
            <!-- Zoom Icon on Hover -->
            <div class="absolute top-3 right-3 bg-slate-900/80 backdrop-blur-sm text-white p-2 rounded-xl opacity-0 group-hover:opacity-100 group-focus:opacity-100 transition-opacity shadow-sm">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
              </svg>
            </div>

            <!-- Title Overlay on Bottom of Image -->
            <div class="absolute bottom-4 left-4 right-4 text-white">
              <span class="inline-block text-xs font-bold text-white bg-sky-600/90 px-3 py-1.5 rounded-lg backdrop-blur-sm shadow-md">
                {item.title}
              </span>
            </div>
          </button>
        </div>
      ))}
    </div>
  )}

  <!-- Accessible Lightbox Modal Dialog -->
  <div
    id="gallery-lightbox"
    class="fixed inset-0 z-50 hidden bg-slate-950/95 backdrop-blur-md flex items-center justify-center p-4 sm:p-6"
    role="dialog"
    aria-modal="true"
    aria-label="Water Tank Image Preview Lightbox"
  >
    <!-- Close Button -->
    <button
      type="button"
      id="lightbox-close"
      class="absolute top-4 right-4 sm:top-6 sm:right-6 text-white/80 hover:text-white bg-white/10 hover:bg-white/20 p-3 rounded-full transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 z-50"
      aria-label="Close image lightbox (Escape)"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Navigation Prev Button -->
    <button
      type="button"
      id="lightbox-prev"
      class="absolute left-2 sm:left-6 top-1/2 -translate-y-1/2 text-white/80 hover:text-white bg-white/10 hover:bg-white/20 p-3 sm:p-4 rounded-full transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 z-50"
      aria-label="Previous image (Left Arrow)"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <!-- Main Container -->
    <div class="max-w-4xl w-full max-h-[90vh] flex flex-col items-center justify-center relative">
      <div class="relative w-full max-h-[70vh] flex items-center justify-center overflow-hidden rounded-2xl bg-black/40">
        <img
          id="lightbox-img"
          src=""
          alt=""
          class="max-w-full max-h-[65vh] object-contain rounded-xl transition-opacity duration-200"
        />
      </div>

      <!-- Title & Details in Modal -->
      <div class="mt-4 text-center text-white max-w-2xl px-4">
        <h4 id="lightbox-title" class="text-lg font-bold text-sky-300"></h4>
        <p id="lightbox-counter" class="text-xs text-slate-400 mt-1 font-mono"></p>
      </div>
    </div>

    <!-- Navigation Next Button -->
    <button
      type="button"
      id="lightbox-next"
      class="absolute right-2 sm:right-6 top-1/2 -translate-y-1/2 text-white/80 hover:text-white bg-white/10 hover:bg-white/20 p-3 sm:p-4 rounded-full transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 z-50"
      aria-label="Next image (Right Arrow)"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>
</div>

<script>
  const track = document.getElementById('gallery-track');
  const prevBtn = document.getElementById('gallery-prev');
  const nextBtn = document.getElementById('gallery-next');

  // Auto-scroll functionality
  if (track) {
    let isHovered = false;
    const getScrollStep = () => {
      const card = track.querySelector('div');
      return card ? card.offsetWidth + 24 : 340;
    };

    const scrollNext = () => {
      if (!isHovered && track) {
        const maxScroll = track.scrollWidth - track.clientWidth;
        if (track.scrollLeft >= maxScroll - 10) {
          track.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          track.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
        }
      }
    };

    let autoScrollInterval = setInterval(scrollNext, 3200);

    track.addEventListener('mouseenter', () => { isHovered = true; });
    track.addEventListener('mouseleave', () => { isHovered = false; });
    track.addEventListener('touchstart', () => { isHovered = true; }, { passive: true });
    track.addEventListener('touchend', () => {
      setTimeout(() => { isHovered = false; }, 4000);
    });

    prevBtn?.addEventListener('click', () => {
      isHovered = true;
      track.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
      setTimeout(() => { isHovered = false; }, 5000);
    });

    nextBtn?.addEventListener('click', () => {
      isHovered = true;
      track.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
      setTimeout(() => { isHovered = false; }, 5000);
    });
  }

  // Lightbox functionality
  const triggers = document.querySelectorAll('.gallery-trigger');
  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxCounter = document.getElementById('lightbox-counter');
  const closeBtn = document.getElementById('lightbox-close');
  const lbPrevBtn = document.getElementById('lightbox-prev');
  const lbNextBtn = document.getElementById('lightbox-next');

  let currentIndex = 0;
  let lastActiveElement: HTMLElement | null = null;

  interface GalleryData {
    image: string;
    title: string;
    alt: string;
  }

  const galleryItems: GalleryData[] = Array.from(triggers).map((btn) => ({
    image: btn.getAttribute('data-image') || '',
    title: btn.getAttribute('data-title') || '',
    alt: btn.getAttribute('data-alt') || '',
  }));

  function updateLightbox(index: number) {
    if (!galleryItems[index]) return;
    currentIndex = index;
    const item = galleryItems[index];

    if (lightboxImg) {
      lightboxImg.style.opacity = '0.5';
      lightboxImg.src = item.image;
      lightboxImg.alt = item.alt;
      setTimeout(() => {
        lightboxImg.style.opacity = '1';
      }, 100);
    }
    if (lightboxTitle) lightboxTitle.textContent = item.title;
    if (lightboxCounter) lightboxCounter.textContent = `Image ${index + 1} of ${galleryItems.length}`;
  }

  function openLightbox(index: number, triggerEl: HTMLElement) {
    lastActiveElement = triggerEl;
    updateLightbox(index);
    if (lightbox) {
      lightbox.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }
  }

  function closeLightbox() {
    if (lightbox) {
      lightbox.classList.add('hidden');
      document.body.style.overflow = '';
      if (lastActiveElement) {
        lastActiveElement.focus();
      }
    }
  }

  function nextImage() {
    const nextIdx = (currentIndex + 1) % galleryItems.length;
    updateLightbox(nextIdx);
  }

  function prevImage() {
    const prevIdx = (currentIndex - 1 + galleryItems.length) % galleryItems.length;
    updateLightbox(prevIdx);
  }

  triggers.forEach((btn, idx) => {
    btn.addEventListener('click', () => {
      openLightbox(idx, btn as HTMLElement);
    });
  });

  closeBtn?.addEventListener('click', closeLightbox);
  lbNextBtn?.addEventListener('click', nextImage);
  lbPrevBtn?.addEventListener('click', prevImage);

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) {
      closeLightbox();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (!lightbox || lightbox.classList.contains('hidden')) return;

    if (e.key === 'Escape') {
      closeLightbox();
    } else if (e.key === 'ArrowRight') {
      nextImage();
    } else if (e.key === 'ArrowLeft') {
      prevImage();
    }
  });
</script>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>
