---
import { siteConfig } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  class?: string;
}

const {
  title = "Ready to Schedule Your Tank Cleaning in Champapet?",
  description = "Call us directly or send a message on WhatsApp with your tank specifications. We are open 24 hours to assist you.",
  class: className = '',
} = Astro.props;
---

<section class={`relative bg-gradient-to-br from-slate-950 via-sky-950 to-slate-900 text-white py-16 sm:py-20 border-t border-sky-900/50 overflow-hidden ${className}`}>
  <!-- Related water background image with smooth overlay -->
  <div class="absolute inset-0 z-0 opacity-20 mix-blend-screen pointer-events-none">
    <img
      src="/images/hero-home.jpg"
      alt="Water storage and purification background texture"
      class="w-full h-full object-cover object-center filter brightness-95"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="absolute -top-32 -left-32 w-80 h-80 bg-sky-500/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-32 -right-32 w-80 h-80 bg-teal-500/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container-custom relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-sky-500/20 border border-sky-400/40 text-sky-300 text-xs font-bold uppercase tracking-wider mb-4 backdrop-blur-sm">
        Direct Helpline & WhatsApp
      </span>

      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white tracking-tight leading-tight mb-4">
        {title}
      </h2>

      <p class="text-base sm:text-lg text-slate-200 leading-relaxed max-w-2xl mx-auto mb-8">
        {description}
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <!-- Call Now Primary -->
        <a
          href={siteConfig.phone.tel}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-sky-600 hover:bg-sky-500 active:bg-sky-700 text-white font-bold text-base px-8 py-4 rounded-xl shadow-lg shadow-sky-600/30 transition-all duration-150 transform hover:-translate-y-0.5"
        >
          <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"/>
          </svg>
          <span>Call {siteConfig.phone.display}</span>
        </a>

        <!-- WhatsApp Chat -->
        <a
          href={siteConfig.phone.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-white font-bold text-base px-8 py-4 rounded-xl shadow-lg shadow-emerald-600/30 transition-all duration-150 transform hover:-translate-y-0.5"
        >
          <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.159.57 4.184 1.564 5.938l-1.564 5.718 5.864-1.538c1.701.927 3.652 1.458 5.727 1.458 6.627 0 12-5.373 12-12 0-6.627-5.373-12-12-12z"/>
          </svg>
          <span>Chat on WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</section>
