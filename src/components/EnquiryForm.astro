---
import { siteConfig } from '../config/site';

interface Props {
  id?: string;
  class?: string;
  title?: string;
  subtitle?: string;
  compact?: boolean;
}

const {
  id = 'enquiry',
  class: className = '',
  title = 'Request a Water Tank Cleaning Quote',
  subtitle = 'Share your tank details and locality in Champapet or nearby areas. We will review your requirements and respond with availability.',
  compact = false,
} = Astro.props;
---

<div id={id} class={`bg-white rounded-2xl p-6 sm:p-8 md:p-10 shadow-card border border-slate-200 ${className}`}>
  <div class="mb-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-water-50 border border-brand-water-200 text-brand-water-700 text-xs font-bold uppercase tracking-wider mb-2">
      <span>Enquiry Form</span>
    </div>
    <h2 class="text-xl sm:text-2xl font-bold text-brand-navy tracking-tight">
      {title}
    </h2>
    <p class="text-sm text-brand-muted mt-1.5 leading-relaxed">
      {subtitle}
    </p>
  </div>

  <form
    name="enquiry"
    method="POST"
    action="/thank-you/"
    data-netlify="true"
    data-netlify-honeypot="bot-field"
    class="space-y-4"
    aria-label="Water Tank Cleaning Service Enquiry Form"
  >
    <!-- Netlify form hidden controls -->
    <input type="hidden" name="form-name" value="enquiry" />
    <p class="hidden">
      <label>
        Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" />
      </label>
    </p>

    <!-- Grid: Name & Phone -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="form-name-input" class="block text-xs font-bold uppercase tracking-wider text-brand-navy mb-1.5">
          Your Name <span class="text-rose-600" aria-hidden="true">*</span>
          <span class="sr-only">(required)</span>
        </label>
        <input
          type="text"
          id="form-name-input"
          name="name"
          required
          autocomplete="name"
          placeholder="e.g. Ramesh Kumar"
          class="w-full px-4 py-3 text-sm rounded-lg border border-slate-300 focus:border-brand-water-600 focus:ring-2 focus:ring-brand-water-600/20 outline-none transition text-brand-charcoal bg-slate-50/50"
        />
      </div>

      <div>
        <label for="form-phone-input" class="block text-xs font-bold uppercase tracking-wider text-brand-navy mb-1.5">
          Phone Number <span class="text-rose-600" aria-hidden="true">*</span>
          <span class="sr-only">(required)</span>
        </label>
        <input
          type="tel"
          id="form-phone-input"
          name="phone"
          required
          autocomplete="tel"
          placeholder="e.g. 098765 43210"
          pattern="[0-9+ -]{8,15}"
          title="Please enter a valid phone number"
          class="w-full px-4 py-3 text-sm rounded-lg border border-slate-300 focus:border-brand-water-600 focus:ring-2 focus:ring-brand-water-600/20 outline-none transition text-brand-charcoal bg-slate-50/50"
        />
      </div>
    </div>

    <!-- Area / Locality -->
    <div>
      <label for="form-locality-input" class="block text-xs font-bold uppercase tracking-wider text-brand-navy mb-1.5">
        Area / Locality in or around Champapet <span class="text-rose-600" aria-hidden="true">*</span>
        <span class="sr-only">(required)</span>
      </label>
      <input
        type="text"
        id="form-locality-input"
        name="locality"
        required
        autocomplete="address-level2"
        placeholder="e.g. Harujanwada, Champapet, or nearby landmark"
        class="w-full px-4 py-3 text-sm rounded-lg border border-slate-300 focus:border-brand-water-600 focus:ring-2 focus:ring-brand-water-600/20 outline-none transition text-brand-charcoal bg-slate-50/50"
      />
    </div>

    <!-- Grid: Service & Approximate Capacity -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="form-tank-type" class="block text-xs font-bold uppercase tracking-wider text-brand-navy mb-1.5">
          Service Type <span class="text-slate-500 font-normal text-[11px]">(optional)</span>
        </label>
        <select
          id="form-tank-type"
          name="tank_type"
          class="w-full px-4 py-3 text-sm rounded-lg border border-slate-300 focus:border-brand-water-600 focus:ring-2 focus:ring-brand-water-600/20 outline-none transition text-brand-charcoal bg-slate-50/50"
        >
          <option value="">Select service</option>
          {siteConfig.services.map((svc) => (
            <option value={svc.title}>{svc.title}</option>
          ))}
          <option value="Multiple Services / Need Guidance">Multiple Services / Need Guidance</option>
        </select>
      </div>

      <div>
        <label for="form-capacity" class="block text-xs font-bold uppercase tracking-wider text-brand-navy mb-1.5">
          Approximate Capacity <span class="text-slate-500 font-normal text-[11px]">(optional)</span>
        </label>
        <select
          id="form-capacity"
          name="capacity"
          class="w-full px-4 py-3 text-sm rounded-lg border border-slate-300 focus:border-brand-water-600 focus:ring-2 focus:ring-brand-water-600/20 outline-none transition text-brand-charcoal bg-slate-50/50"
        >
          <option value="">Select capacity</option>
          <option value="500 to 1,000 Litres">500 to 1,000 Litres</option>
          <option value="1,000 to 2,000 Litres">1,000 to 2,000 Litres</option>
          <option value="2,000 to 5,000 Litres">2,000 to 5,000 Litres</option>
          <option value="5,000 to 10,000 Litres">5,000 to 10,000 Litres</option>
          <option value="10,000+ Litres (Commercial/Apartment/Industrial)">10,000+ Litres (Commercial/Industrial)</option>
          <option value="Unsure / Need Assessment">Unsure / Need Assessment</option>
        </select>
      </div>
    </div>

    <!-- Message / Access notes -->
    <div>
      <label for="form-message" class="block text-xs font-bold uppercase tracking-wider text-brand-navy mb-1.5">
        Additional Notes / Access Details <span class="text-slate-500 font-normal text-[11px]">(optional)</span>
      </label>
      <textarea
        id="form-message"
        name="message"
        rows="3"
        placeholder="e.g. Roof ladder available, water scheduled for Wednesday..."
        class="w-full px-4 py-3 text-sm rounded-lg border border-slate-300 focus:border-brand-water-600 focus:ring-2 focus:ring-brand-water-600/20 outline-none transition text-brand-charcoal bg-slate-50/50 resize-y"
      ></textarea>
    </div>

    <!-- Privacy & Scope Notice -->
    <p class="text-xs text-brand-muted leading-relaxed">
      Submitted details are used solely to respond to your cleaning enquiry and discuss scheduling. Submitting this form does not constitute a confirmed booking.
    </p>

    <!-- Submit Button & WhatsApp prompt -->
    <div class="pt-2 flex flex-col sm:flex-row items-center gap-4">
      <button
        type="submit"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-brand-water-600 hover:bg-brand-water-500 text-white font-bold text-base px-8 py-3.5 rounded-xl shadow-md transition-all duration-150 focus-visible:ring-2 focus-visible:ring-brand-water-600"
      >
        <span>Send Enquiry</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>

      <a
        href={siteConfig.phone.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm px-6 py-3.5 rounded-xl shadow-sm transition-all"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.159.57 4.184 1.564 5.938l-1.564 5.718 5.864-1.538c1.701.927 3.652 1.458 5.727 1.458 6.627 0 12-5.373 12-12 0-6.627-5.373-12-12-12z"/>
        </svg>
        <span>Instant WhatsApp</span>
      </a>
    </div>
  </form>
</div>
