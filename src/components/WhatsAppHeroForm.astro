---
import { siteConfig } from '../config/site';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`bg-white rounded-3xl p-6 sm:p-7 shadow-2xl border border-slate-200/80 relative overflow-hidden ring-1 ring-slate-900/5 ${className}`}>
  <!-- Decorative top gradient bar -->
  <div class="absolute top-0 inset-x-0 h-2.5 bg-gradient-to-r from-sky-500 via-teal-500 to-emerald-500"></div>

  <!-- Header -->
  <div class="flex items-center justify-between gap-3 mb-4 pt-1 pb-3 border-b border-slate-100">
    <div>
      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-bold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Direct WhatsApp Booking
      </span>
      <h3 class="text-xl font-extrabold text-slate-900 mt-1.5 tracking-tight">
        Request Quick Quote
      </h3>
      <p class="text-xs text-slate-500 mt-0.5">Quick confirmation • Available 24 Hours</p>
    </div>
    <div class="w-11 h-11 rounded-2xl bg-emerald-500 text-white flex items-center justify-center shrink-0 shadow-md shadow-emerald-500/30">
      <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.159.57 4.184 1.564 5.938l-1.564 5.718 5.864-1.538c1.701.927 3.652 1.458 5.727 1.458 6.627 0 12-5.373 12-12 0-6.627-5.373-12-12-12z"/>
      </svg>
    </div>
  </div>

  <form id="hero-whatsapp-form" class="space-y-3.5">
    <!-- 1. Name -->
    <div>
      <label for="hero-name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
        Your Name <span class="text-rose-500">*</span>
      </label>
      <input
        type="text"
        id="hero-name"
        name="name"
        required
        autocomplete="name"
        placeholder="Enter your name (e.g. Ramesh Reddy)"
        class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-300 bg-slate-50 focus:bg-white focus:border-sky-600 focus:ring-4 focus:ring-sky-500/10 outline-none transition font-medium text-slate-800 placeholder-slate-400"
      />
    </div>

    <!-- 2. Mobile Number -->
    <div>
      <label for="hero-phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
        Mobile Number <span class="text-rose-500">*</span>
      </label>
      <input
        type="tel"
        id="hero-phone"
        name="phone"
        required
        autocomplete="tel"
        placeholder="e.g. 082477 35114"
        pattern="[0-9+ -]{8,15}"
        class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-300 bg-slate-50 focus:bg-white focus:border-sky-600 focus:ring-4 focus:ring-sky-500/10 outline-none transition font-medium text-slate-800 placeholder-slate-400"
      />
    </div>

    <!-- 3. Service Selection -->
    <div>
      <label for="hero-service" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
        Service Required <span class="text-rose-500">*</span>
      </label>
      <select
        id="hero-service"
        name="service"
        required
        class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-300 bg-slate-50 focus:bg-white focus:border-sky-600 focus:ring-4 focus:ring-sky-500/10 outline-none transition font-medium text-slate-800"
      >
        <option value="">Choose a service</option>
        {siteConfig.services.map((svc) => (
          <option value={svc.title}>{svc.title}</option>
        ))}
        <option value="Both Overhead & Underground Sump">Both Overhead & Underground Sump</option>
      </select>
    </div>

    <!-- 4. Message / Any Notes -->
    <div>
      <label for="hero-message" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
        Message / Any Notes <span class="text-slate-400 font-normal text-[11px]">(optional)</span>
      </label>
      <input
        type="text"
        id="hero-message"
        name="message"
        placeholder="e.g. 1000L Sintex tank / Preferred time"
        class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-300 bg-slate-50 focus:bg-white focus:border-sky-600 focus:ring-4 focus:ring-sky-500/10 outline-none transition font-medium text-slate-800 placeholder-slate-400"
      />
    </div>

    <!-- 5. Submit Button -->
    <div class="pt-1.5">
      <button
        type="submit"
        class="w-full flex items-center justify-center gap-2.5 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white font-bold text-base py-3.5 px-5 rounded-xl shadow-lg shadow-emerald-600/30 transition-all duration-150 transform hover:-translate-y-0.5 active:translate-y-0"
      >
        <svg class="w-5 h-5 text-white shrink-0" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.159.57 4.184 1.564 5.938l-1.564 5.718 5.864-1.538c1.701.927 3.652 1.458 5.727 1.458 6.627 0 12-5.373 12-12 0-6.627-5.373-12-12-12z"/>
        </svg>
        <span>Send Enquiry on WhatsApp</span>
      </button>
    </div>

    <div class="text-center pt-1 text-xs text-slate-500 flex items-center justify-center gap-1.5">
      <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
      </svg>
      <span>Instant response on <strong>082477 35114</strong></span>
    </div>
  </form>
</div>

<script>
  const form = document.getElementById('hero-whatsapp-form') as HTMLFormElement;
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('hero-name') as HTMLInputElement)?.value.trim() || '';
      const phone = (document.getElementById('hero-phone') as HTMLInputElement)?.value.trim() || '';
      const service = (document.getElementById('hero-service') as HTMLSelectElement)?.value.trim() || '';
      const notes = (document.getElementById('hero-message') as HTMLInputElement)?.value.trim() || '';

      if (!name || !phone || !service) {
        alert('Please enter your name, mobile number, and select a service.');
        return;
      }

      const waNumber = '918247735114';
      let message = `*Water Tank Cleaning Enquiry*\n\n`;
      message += `*Name:* ${name}\n`;
      message += `*Mobile:* ${phone}\n`;
      message += `*Service:* ${service}\n`;
      if (notes) {
        message += `*Notes:* ${notes}\n`;
      }
      message += `\n*Location Focus:* Champapet, Telangana`;

      const encoded = encodeURIComponent(message);
      const waUrl = `https://wa.me/${waNumber}?text=${encoded}`;

      window.open(waUrl, '_blank');
    });
  }
</script>
