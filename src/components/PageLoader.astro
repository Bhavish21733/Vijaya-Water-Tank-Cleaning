---
// PageLoader.astro - Water Tank Filling Loading Animation
---

<div id="site-page-loader" class="page-loader-overlay">
  <div class="loader-container">
    <!-- Animated Water Tank Container -->
    <div class="tank-wrapper">
      <!-- Water Tank SVG with Animated Fill Wave -->
      <svg class="tank-svg" viewBox="0 0 100 120" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <!-- Water Gradient -->
          <linearGradient id="waterGradient" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#38BDF8" />
            <stop offset="50%" stop-color="#0284C7" />
            <stop offset="100%" stop-color="#0369A1" />
          </linearGradient>

          <!-- Tank Mask for Water Fill -->
          <clipPath id="tankMask">
            <!-- Tank Body Shape (Top cap, main body with rounded corners) -->
            <path d="M30 14 C30 10, 70 10, 70 14 L78 24 C82 24, 85 27, 85 32 L85 102 C85 110, 78 114, 70 114 L30 114 C22 114, 15 110, 15 102 L15 32 C15 27, 18 24, 22 24 Z" />
          </clipPath>
        </defs>

        <!-- Tank Background Inside -->
        <path
          d="M30 14 C30 10, 70 10, 70 14 L78 24 C82 24, 85 27, 85 32 L85 102 C85 110, 78 114, 70 114 L30 114 C22 114, 15 110, 15 102 L15 32 C15 27, 18 24, 22 24 Z"
          fill="#082F49"
          stroke="#0EA5E9"
          stroke-width="2.5"
        />

        <!-- Water Fill Group Clipped to Tank Body -->
        <g clip-path="url(#tankMask)">
          <!-- Rising Water Level -->
          <g class="water-rise-group">
            <!-- Animated Water Wave 1 -->
            <path
              class="water-wave wave-back"
              d="M-100 0 Q -50 -8, 0 0 T 100 0 T 200 0 T 300 0 L300 140 L-100 140 Z"
              fill="#0284C7"
              opacity="0.6"
            />
            <!-- Animated Water Wave 2 (Front) -->
            <path
              class="water-wave wave-front"
              d="M-100 0 Q -50 8, 0 0 T 100 0 T 200 0 T 300 0 L300 140 L-100 140 Z"
              fill="url(#waterGradient)"
            />
            
            <!-- Rising Bubbles -->
            <circle class="bubble bubble-1" cx="35" cy="40" r="2.5" fill="#BAE6FD" opacity="0.8" />
            <circle class="bubble bubble-2" cx="65" cy="55" r="3.5" fill="#BAE6FD" opacity="0.7" />
            <circle class="bubble bubble-3" cx="50" cy="70" r="2" fill="#BAE6FD" opacity="0.9" />
          </g>
        </g>

        <!-- Tank Structural Ridges (Sintex Style) -->
        <line x1="20" y1="44" x2="80" y2="44" stroke="#38BDF8" stroke-width="1.5" stroke-dasharray="2 3" opacity="0.5" />
        <line x1="18" y1="64" x2="82" y2="64" stroke="#38BDF8" stroke-width="1.5" stroke-dasharray="2 3" opacity="0.5" />
        <line x1="18" y1="84" x2="82" y2="84" stroke="#38BDF8" stroke-width="1.5" stroke-dasharray="2 3" opacity="0.5" />

        <!-- Tank Lid Top Handle -->
        <rect x="42" y="6" width="16" height="5" rx="2" fill="#38BDF8" />

        <!-- Tank Glass Highlight -->
        <path d="M22 30 L22 98" stroke="white" stroke-width="2" stroke-linecap="round" opacity="0.3" />
      </svg>

      <!-- Water Droplet Splash Effect on Top -->
      <div class="droplet-container">
        <div class="water-drop"></div>
      </div>
    </div>

    <!-- Branding & Progress Text -->
    <div class="loader-text-group">
      <span class="loader-brand">VIJAYA</span>
      <span class="loader-sub">WATER TANK CLEANING</span>
      <div class="loader-bar-track">
        <div class="loader-bar-fill"></div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Base Overlay */
  .page-loader-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background-color: #051E30;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.45s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.45s ease;
    visibility: visible;
    opacity: 1;
    pointer-events: all;
  }

  .page-loader-overlay.loaded {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .loader-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem;
  }

  /* Tank Animation */
  .tank-wrapper {
    position: relative;
    width: 100px;
    height: 120px;
    filter: drop-shadow(0 0 25px rgba(2, 132, 199, 0.4));
    animation: tankFloat 2.4s ease-in-out infinite alternate;
  }

  .tank-svg {
    width: 100%;
    height: 100%;
  }

  /* Rising Water */
  .water-rise-group {
    animation: waterRise 1.6s ease-out forwards;
    transform-origin: bottom center;
  }

  @keyframes waterRise {
    0% {
      transform: translateY(110px);
    }
    100% {
      transform: translateY(18px);
    }
  }

  /* Water Wave Animation */
  .water-wave {
    animation: waveScroll 1.8s linear infinite;
  }

  .wave-front {
    animation: waveScroll 1.4s linear infinite reverse;
  }

  @keyframes waveScroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-100px);
    }
  }

  /* Bubbles Floating Up */
  .bubble-1 {
    animation: bubbleRise 1.8s infinite ease-in;
  }
  .bubble-2 {
    animation: bubbleRise 2.2s infinite ease-in 0.4s;
  }
  .bubble-3 {
    animation: bubbleRise 1.5s infinite ease-in 0.8s;
  }

  @keyframes bubbleRise {
    0% {
      transform: translateY(20px);
      opacity: 0;
    }
    50% {
      opacity: 0.9;
    }
    100% {
      transform: translateY(-40px);
      opacity: 0;
    }
  }

  @keyframes tankFloat {
    0% {
      transform: translateY(0px);
    }
    100% {
      transform: translateY(-6px);
    }
  }

  /* Falling Water Drop */
  .droplet-container {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
  }

  .water-drop {
    width: 8px;
    height: 12px;
    background: #38BDF8;
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    animation: dropFall 1.2s cubic-bezier(0.4, 0, 1, 1) infinite;
    filter: drop-shadow(0 0 6px #38BDF8);
  }

  @keyframes dropFall {
    0% {
      transform: translateY(-20px) scale(0.6);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    80% {
      transform: translateY(24px) scale(1);
      opacity: 1;
    }
    100% {
      transform: translateY(28px) scale(1.4, 0.4);
      opacity: 0;
    }
  }

  /* Loader Typography */
  .loader-text-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .loader-brand {
    font-size: 1.15rem;
    font-weight: 900;
    letter-spacing: 0.2em;
    color: #FFFFFF;
    text-shadow: 0 0 12px rgba(56, 189, 248, 0.5);
  }

  .loader-sub {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #38BDF8;
    margin-top: 0.15rem;
  }

  /* Progress Bar */
  .loader-bar-track {
    width: 120px;
    height: 3px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    overflow: hidden;
    margin-top: 0.75rem;
  }

  .loader-bar-fill {
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, #0284C7, #38BDF8, #25D366);
    border-radius: 9999px;
    animation: progressFill 1.4s ease-in-out forwards;
    transform-origin: left;
  }

  @keyframes progressFill {
    0% {
      transform: scaleX(0);
    }
    50% {
      transform: scaleX(0.7);
    }
    100% {
      transform: scaleX(1);
    }
  }
</style>

<script>
  function dismissLoader() {
    const loader = document.getElementById('site-page-loader');
    if (!loader) return;
    loader.classList.add('loaded');
    setTimeout(() => {
      if (loader.parentNode) {
        loader.style.display = 'none';
      }
    }, 500);
  }

  // Dismiss when page has loaded, with a maximum 1.5s timeout for instant UX
  if (document.readyState === 'complete') {
    setTimeout(dismissLoader, 600);
  } else {
    window.addEventListener('load', () => {
      setTimeout(dismissLoader, 500);
    });
    // Fallback safety timeout
    setTimeout(dismissLoader, 1400);
  }
</script>
