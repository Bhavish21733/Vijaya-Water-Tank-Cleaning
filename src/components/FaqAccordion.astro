---
interface FaqItem {
  question: string;
  answer: string;
}

const faqs: FaqItem[] = [
  {
    question: "How is the cleaning quote determined for our water tank or sump?",
    answer: "Quotes depend on several practical site factors including total storage capacity (in litres), tank material (plastic, RCC, or masonry), the volume of accumulated sediment or silt, and physical accessibility (such as ladder access or roof staging). Sharing these details during your initial enquiry allows us to discuss scope and pricing accurately."
  },
  {
    question: "What details should I prepare before contacting Vijaya Water Tank Cleaning?",
    answer: "Having the approximate capacity (e.g., 1000L, 2000L, or multi-compartment sump), structure type (rooftop tank, ground sump, or both), and your specific location in Champapet or nearby makes the discussion smooth. If you know when your current water supply is low, let us know so we can schedule around your routine."
  },
  {
    question: "How should our household prepare on the day of the cleaning appointment?",
    answer: "We advise utilizing existing stored water in advance so minimal water is drained during the service. Ensure clear access to the rooftop ladder or underground sump cover, make an outdoor electrical outlet available for pumps, and let household occupants know that water taps should remain closed during the cleaning window."
  },
  {
    question: "Do you clean both overhead rooftop tanks and underground sumps?",
    answer: "Yes. We service rooftop tanks (molded plastic, Sintex, concrete) as well as underground sumps for independent houses, gated villas, and apartment buildings. Many property owners choose to schedule both on the same day to maintain their entire water storage system."
  },
  {
    question: "How long does a water tank cleaning service typically take?",
    answer: "Service duration varies based on the size of the tank, the amount of settled sediment, and site access. A single residential overhead tank typically takes less time than a large multi-compartment apartment sump with extensive silt. We discuss estimated time windows when you confirm your appointment."
  },
  {
    question: "Which areas do you serve from your Champapet location?",
    answer: "Our primary business location is in Harujanwada, Champapet, Telangana 500059. We serve residential and commercial properties in Champapet and surrounding localities. You can call 082477 35114 to enquire about current schedule availability for your specific address."
  }
];
---

<div class="space-y-4 max-w-4xl mx-auto" id="faq-accordion">
  {faqs.map((faq, index) => (
    <details class="group bg-white rounded-xl border border-brand-navy-100 shadow-sm overflow-hidden transition-all duration-200 open:shadow-md open:border-brand-teal/40">
      <summary class="flex items-center justify-between p-5 sm:p-6 text-left cursor-pointer select-none font-bold text-base sm:text-lg text-brand-navy group-hover:text-brand-teal transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-teal">
        <span class="pr-4">{faq.question}</span>
        <span class="ml-2 shrink-0 w-8 h-8 rounded-full bg-brand-navy-50 group-open:bg-brand-teal group-open:text-white text-brand-navy flex items-center justify-center transition-all duration-200">
          <svg class="w-4 h-4 transform group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </span>
      </summary>
      <div class="px-5 pb-5 sm:px-6 sm:pb-6 text-sm sm:text-base text-brand-muted leading-relaxed border-t border-slate-100/80 pt-4">
        <p>{faq.answer}</p>
      </div>
    </details>
  ))}
</div>
