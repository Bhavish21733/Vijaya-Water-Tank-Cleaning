---
interface Props {
  variant?: 'primary' | 'secondary' | 'accent' | 'outline' | 'dark';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  id?: string;
  [key: string]: any;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  class: className = '',
  id,
  ...rest
} = Astro.props;

const baseStyles = "inline-flex items-center justify-center font-semibold rounded-lg transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 text-center select-none shadow-sm active:scale-[0.98]";

const variants = {
  primary: "bg-brand-teal text-white hover:bg-brand-teal-600 focus-visible:ring-brand-teal active:bg-brand-teal-700 shadow-md",
  secondary: "bg-brand-navy text-white hover:bg-brand-navy-900 focus-visible:ring-brand-navy active:bg-brand-navy-950",
  accent: "bg-brand-amber-600 text-white hover:bg-brand-amber-700 focus-visible:ring-brand-amber-500",
  outline: "border-2 border-brand-teal text-brand-teal hover:bg-brand-teal-50 focus-visible:ring-brand-teal",
  dark: "bg-white/10 hover:bg-white/20 text-white border border-white/30 backdrop-blur-sm focus-visible:ring-white",
};

const sizes = {
  sm: "text-sm px-3.5 py-1.5 min-h-[38px] gap-1.5",
  md: "text-base px-5 py-2.5 min-h-[44px] gap-2",
  lg: "text-lg px-7 py-3.5 min-h-[52px] gap-2.5",
};

const classes = `${baseStyles} ${variants[variant]} ${sizes[size]} ${className}`;
---

{
  href ? (
    <a href={href} class={classes} id={id} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} id={id} {...rest}>
      <slot />
    </button>
  )
}
