---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroInterior from '../components/HeroInterior.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { siteConfig } from '../config/site';

const breadcrumbs = [
  { name: 'Services' }
];
---

<BaseLayout
  title="Tank & Sump Cleaning in Champapet | Vijaya"
  description="Explore all 6 water tank cleaning services in Champapet: Residential, Commercial, Overhead, Underground sumps, Industrial, and Sump & Sintex cleaning."
  breadcrumbs={breadcrumbs}
>
  <!-- Interior Hero with dark overlay, breadcrumbs, one H1, description, and exactly two CTAs -->
  <HeroInterior
    title='Our 6 <span class="text-[#00a6ff]">Water Tank Cleaning</span><br class="hidden sm:inline" /> Services in Champapet'
    description="Professional sediment extraction, dewatering, high-pressure washing, and surface cleaning for residential houses, commercial buildings, and industrial plants across Champapet."
    eyebrow="LOCAL & SAFE WATER SOLUTIONS"
    breadcrumbs={breadcrumbs}
    bgImage="/images/hero-about.webp"
    bgImageAlt="Water tank cleaning equipment and reservoir maintenance in Champapet"
  />

  <!-- 6 Service Sections -->
  <div class="py-12 sm:py-16 space-y-12 sm:space-y-16">
    {siteConfig.services.map((svc, index) => {
      const isEven = index % 2 === 1;
      return (
        <section id={svc.id} class="scroll-mt-24">
          <div class="container-custom">
            <div class={`bg-white rounded-3xl p-6 sm:p-10 lg:p-12 border border-slate-200 shadow-card grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center text-left`}>
              
              <!-- Image Column -->
              <div class={`lg:col-span-5 ${isEven ? 'lg:order-2' : 'lg:order-1'}`}>
                <div class="relative rounded-3xl overflow-hidden shadow-md bg-slate-900 aspect-[4/3]">
                  <img
                    src={svc.image}
                    alt={svc.imageAlt}
                    class="w-full h-full object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
                  <span class="absolute bottom-3 left-3 text-xs font-bold text-white bg-sky-600/90 px-3 py-1 rounded-lg backdrop-blur-sm shadow-sm">
                    {svc.title}
                  </span>
                </div>
                <p class="text-[11px] text-slate-500 mt-2 italic text-center sm:text-left">
                  {svc.representativeCaption}
                </p>
              </div>

              <!-- Content Column -->
              <div class={`lg:col-span-7 space-y-5 ${isEven ? 'lg:order-1' : 'lg:order-2'}`}>
                <div>
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-sky-50 border border-sky-200 text-sky-700 text-xs font-bold uppercase tracking-wider mb-2">
                    Service #{index + 1}
                  </span>
                  <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
                    {svc.title}
                  </h2>
                  <p class="text-base text-slate-600 mt-3 leading-relaxed">
                    {svc.fullDescription}
                  </p>
                </div>

                <!-- Typical Context -->
                <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 text-sm">
                  <p class="font-bold text-slate-900 text-xs uppercase tracking-wider mb-1">Typical Customer Context</p>
                  <p class="text-slate-600">{svc.typicalContext}</p>
                </div>

                <!-- Grid: Enquiry Checklist & Pricing Factors -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <!-- Checklist -->
                  <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
                    <p class="font-bold text-slate-900 text-xs uppercase tracking-wider">Information Needed to Book</p>
                    <ul class="space-y-1.5 text-xs text-slate-600">
                      {svc.enquiryChecklist.map((item) => (
                        <li class="flex items-start gap-2">
                          <span class="text-sky-600 font-bold shrink-0">✓</span>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <!-- Pricing Factors -->
                  <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
                    <p class="font-bold text-slate-900 text-xs uppercase tracking-wider">Quote & Pricing Factors</p>
                    <ul class="space-y-1.5 text-xs text-slate-600">
                      {svc.pricingFactors.map((factor) => (
                        <li class="flex items-start gap-2">
                          <span class="text-amber-500 font-bold shrink-0">•</span>
                          <span>{factor}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <!-- Quote Note & Actions -->
                <div class="pt-2 flex flex-wrap items-center gap-4">
                  <a
                    href={siteConfig.phone.tel}
                    class="inline-flex items-center gap-2 bg-sky-600 hover:bg-sky-500 text-white font-bold text-sm px-5 py-3 rounded-xl shadow-md transition-colors"
                  >
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"/>
                    </svg>
                    <span>Call to Enquire</span>
                  </a>

                  <a
                    href={siteConfig.phone.whatsappUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm px-5 py-3 rounded-xl shadow-md transition-colors"
                  >
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.159.57 4.184 1.564 5.938l-1.564 5.718 5.864-1.538c1.701.927 3.652 1.458 5.727 1.458 6.627 0 12-5.373 12-12 0-6.627-5.373-12-12-12z"/>
                    </svg>
                    <span>Enquire on WhatsApp</span>
                  </a>
                </div>

              </div>

            </div>
          </div>
        </section>
      );
    })}
  </div>

  <!-- Closing Conversion CTA -->
  <ClosingCta
    title="Need a Tank Cleaning Service in Champapet?"
    description="Call 082477 35114 or connect on WhatsApp to discuss your tank specifications."
  />
</BaseLayout>
