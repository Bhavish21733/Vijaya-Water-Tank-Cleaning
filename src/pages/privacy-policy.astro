---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroInterior from '../components/HeroInterior.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { siteConfig } from '../config/site';

const breadcrumbs = [
  { name: 'Privacy Policy' }
];
---

<BaseLayout
  title="Privacy Policy | Vijaya Water Tank Cleaning"
  description="Privacy policy and data handling practices for Vijaya Water Tank Cleaning Services in Champapet, Telangana. Learn how we handle your enquiry details."
  breadcrumbs={breadcrumbs}
>
  <!-- Interior Hero with same design as About Us -->
  <HeroInterior
    title='Privacy Policy & <span class="text-[#00a6ff]">Data Protection</span><br class="hidden sm:inline" /> Vijaya Services'
    description="Learn how Vijaya Water Tank Cleaning Services collects, uses, and safeguards customer contact and service enquiry details in Champapet."
    eyebrow="LEGAL & TRANSPARENCY"
    breadcrumbs={breadcrumbs}
    bgImage="/images/hero-about.webp"
    bgImageAlt="Clean water storage background in Champapet"
  />

  <!-- Main Privacy Policy Content -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="container-custom max-w-4xl text-left">
      <div class="prose prose-slate max-w-none space-y-8 text-slate-700 leading-relaxed text-sm sm:text-base">
        
        <div>
          <span class="inline-block text-xs font-bold text-sky-700 bg-sky-50 border border-sky-200 px-3 py-1 rounded-full uppercase tracking-wider mb-2">
            Last Updated: January 2026
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            Our Commitment to Your Privacy
          </h2>
          <p class="mt-3 text-slate-600">
            <strong>{siteConfig.name}</strong> ("we," "our," or "us") provides professional water tank, sump, and Sintex cleaning services based in Harujanwada, Champapet, Telangana (500059). This Privacy Policy explains our practices regarding the collection, use, and disclosure of information when you contact us or use our website (<a href={siteConfig.siteUrl} class="text-sky-600 hover:underline font-semibold">{siteConfig.siteUrl}</a>).
          </p>
        </div>

        <div class="border-t border-slate-200 pt-6">
          <h3 class="text-xl font-bold text-slate-900 mb-3">1. Information We Collect</h3>
          <p>
            When you call us, message us via WhatsApp, or submit an online booking enquiry, we collect only the necessary details required to deliver our cleaning services, including:
          </p>
          <ul class="list-disc pl-6 space-y-2 mt-2 text-slate-600">
            <li><strong>Contact Details:</strong> Your full name, mobile number, and WhatsApp contact handle.</li>
            <li><strong>Service Location:</strong> Your property address, building landmark, and locality in or around Champapet / Hyderabad.</li>
            <li><strong>Tank Specifications:</strong> Approximate tank capacity (e.g. 1000L Sintex, 10,000L concrete sump), roof access conditions, and preferred date/time for service.</li>
            <li><strong>Inspection Media:</strong> Any photos or short videos you choose to send via WhatsApp to help us evaluate silt depth or ladder accessibility.</li>
          </ul>
        </div>

        <div class="border-t border-slate-200 pt-6">
          <h3 class="text-xl font-bold text-slate-900 mb-3">2. How We Use Your Information</h3>
          <p>We use the collected information exclusively to:</p>
          <ul class="list-disc pl-6 space-y-2 mt-2 text-slate-600">
            <li>Provide accurate estimates, cost quotations, and appointment confirmation for tank cleaning.</li>
            <li>Dispatch our service crew and equipment to your exact location in Champapet.</li>
            <li>Communicate service updates, before/after inspection photos, or water refill readiness.</li>
            <li>Respond to direct customer service inquiries and support requests.</li>
          </ul>
        </div>

        <div class="border-t border-slate-200 pt-6">
          <h3 class="text-xl font-bold text-slate-900 mb-3">3. Data Sharing & Zero Spam Guarantee</h3>
          <p>
            We respect your privacy. <strong>We do not sell, rent, trade, or share your personal contact information with third-party advertisers or telemarketers.</strong> Your details are solely used by our internal operations team to fulfill your water tank cleaning service.
          </p>
        </div>

        <div class="border-t border-slate-200 pt-6">
          <h3 class="text-xl font-bold text-slate-900 mb-3">4. Data Security & Storage</h3>
          <p>
            We implement appropriate administrative and operational security measures to safeguard your contact details. Communications via WhatsApp are protected by WhatsApp’s standard end-to-end encryption protocols.
          </p>
        </div>

        <div class="border-t border-slate-200 pt-6">
          <h3 class="text-xl font-bold text-slate-900 mb-3">5. Contact Information</h3>
          <p>
            If you have any questions or concerns regarding our privacy practices, please reach out to us directly:
          </p>
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 mt-4 space-y-2 text-sm text-slate-700">
            <p><strong>Business Name:</strong> {siteConfig.name}</p>
            <p><strong>Physical Address:</strong> {siteConfig.address.full}</p>
            <p><strong>Phone Helpline:</strong> <a href={siteConfig.phone.tel} class="text-sky-600 font-bold hover:underline">{siteConfig.phone.display}</a> (Open 24 Hours)</p>
            <p><strong>WhatsApp Support:</strong> <a href={siteConfig.phone.whatsappUrl} target="_blank" rel="noopener noreferrer" class="text-emerald-700 font-bold hover:underline">+{siteConfig.phone.whatsapp}</a></p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Closing Conversion CTA -->
  <ClosingCta
    title="Ready to Schedule Your Water Tank Cleaning?"
    description="Call 082477 35114 or connect via WhatsApp for fast scheduling across Champapet."
  />
</BaseLayout>
