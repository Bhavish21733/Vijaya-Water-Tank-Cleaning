---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title="Page Not Found | Vijaya Water Tank Cleaning"
  description="The page you are looking for does not exist. Navigate back to our water tank cleaning services in Champapet."
  noindex={true}
>
  <section class="py-20 sm:py-32 bg-white flex items-center justify-center min-h-[60vh]">
    <div class="container-custom text-center max-w-xl">
      <span class="inline-block px-3 py-1 rounded-full bg-rose-50 text-rose-700 text-xs font-bold uppercase tracking-wider mb-4 border border-rose-200">
        404 Error
      </span>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-brand-navy tracking-tight mb-4">
        Page Not Found
      </h1>

      <p class="text-base text-brand-muted leading-relaxed mb-8">
        We could not find the page you requested. It might have been moved or removed. You can browse our services or call us directly.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 bg-brand-teal hover:bg-brand-teal-600 text-white font-bold text-sm px-6 py-3 rounded-xl transition-colors shadow"
        >
          <span>Return to Homepage</span>
        </a>

        <a
          href={siteConfig.phone.tel}
          class="inline-flex items-center gap-2 bg-brand-navy hover:bg-brand-navy-900 text-white font-bold text-sm px-6 py-3 rounded-xl transition-colors"
        >
          <span>Call {siteConfig.phone.display}</span>
        </a>
      </div>

      <div class="mt-12 pt-8 border-t border-slate-100 flex justify-center gap-6 text-xs text-brand-muted">
        <a href="/services/" class="hover:text-brand-teal underline">Services</a>
        <a href="/blog/" class="hover:text-brand-teal underline">Maintenance Blog</a>
        <a href="/gallery/" class="hover:text-brand-teal underline">Gallery</a>
        <a href="/contact/" class="hover:text-brand-teal underline">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>
