---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroInterior from '../components/HeroInterior.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { siteConfig } from '../config/site';

const breadcrumbs = [
  { name: 'Terms & Conditions' }
];
---

<BaseLayout
  title="Terms & Conditions | Vijaya Water Tank Cleaning"
  description="Terms and conditions of service for Vijaya Water Tank Cleaning Services in Champapet, Telangana. Scope of work, safety guidelines, and payment policies."
  breadcrumbs={breadcrumbs}
>
  <!-- Interior Hero with same design as About Us -->
  <HeroInterior
    title='Terms of Service & <span class="text-[#00a6ff]">Conditions</span><br class="hidden sm:inline" /> Vijaya Services'
    description="Read our service policies, site preparation recommendations, scope of work, and booking terms in Champapet, Telangana."
    eyebrow="LEGAL & TRANSPARENCY"
    breadcrumbs={breadcrumbs}
    bgImage="/images/hero-about.webp"
    bgImageAlt="Clean water storage tank setup in Champapet"
  />

  <!-- Main Terms & Conditions Content -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="container-custom max-w-4xl text-left">
      <div class="prose prose-slate max-w-none space-y-8 text-slate-700 leading-relaxed text-sm sm:text-base">
        
        <div>
          <span class="inline-block text-xs font-bold text-sky-700 bg-sky-50 border border-sky-200 px-3 py-1 rounded-full uppercase tracking-wider mb-2">
            Last Updated: January 2026
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            Service Terms & Operational Guidelines
          </h2>
          <p class="mt-3 text-slate-600">
            Welcome to <strong>{siteConfig.name}</strong>. By scheduling or booking our water tank cleaning services, whether via phone call, WhatsApp, or website enquiry, you agree to comply with the operational terms outlined below.
          </p>
        </div>

        <div class="border-t border-slate-200 pt-6">
          <h3 class="text-xl font-bold text-slate-900 mb-3">1. Scope of Cleaning Services</h3>
          <p>
            Our core services include physical dewatering, bottom silt and sludge extraction, high-pressure jet washing / manual surface scrubbing, and post-clean freshwater rinsing for:
          </p>
          <ul class="list-disc pl-6 space-y-2 mt-2 text-slate-600">
            <li>Overhead plastic (Sintex / HDPE) and concrete (RCC) tanks.</li>
            <li>Underground masonry sumps and storage reservoirs.</li>
            <li>Residential, apartment complex, commercial facility, and industrial storage tanks.</li>
          </ul>
        </div>

        <div class="border-t border-slate-200 pt-6">
          <h3 class="text-xl font-bold text-slate-900 mb-3">2. Site Preparation & Customer Cooperation</h3>
          <p>To ensure a swift, seamless, and safe cleaning visit, customers are requested to:</p>
          <ul class="list-disc pl-6 space-y-2 mt-2 text-slate-600">
            <li><strong>Water Level Management:</strong> Plan your water usage so that the tank water level is relatively low prior to our crew's arrival to prevent excessive fresh water wastage.</li>
            <li><strong>Power & Water Access:</strong> Provide access to a standard electrical outlet for our submersible dewatering pumps and a working water supply for jet rinsing.</li>
            <li><strong>Ladder & Safe Access:</strong> Ensure safe physical access to rooftop terraces or underground sump manhole covers.</li>
          </ul>
        </div>

        <div class="border-t border-slate-200 pt-6">
          <h3 class="text-xl font-bold text-slate-900 mb-3">3. Quotations, Pricing & Payment</h3>
          <p>
            Estimates provided over phone or WhatsApp are based on the tank type, capacity, and access conditions shared by the customer. In rare cases where severe structural scaling or non-standard sludge depth is encountered, any price adjustments will be discussed with the customer before commencement. Payment is due upon completion of the service via Cash, UPI, or Bank Transfer.
          </p>
        </div>

        <div class="border-t border-slate-200 pt-6">
          <h3 class="text-xl font-bold text-slate-900 mb-3">4. Safety & Structural Integrity</h3>
          <p>
            Our crew exercises utmost care when handling ladders, pipe fittings, and high-pressure washers. Pre-existing structural cracks, aged brittle PVC fittings, or corroded tank hardware should be brought to our technician's attention before work begins.
          </p>
        </div>

        <div class="border-t border-slate-200 pt-6">
          <h3 class="text-xl font-bold text-slate-900 mb-3">5. Rescheduling & Cancellations</h3>
          <p>
            We operate 24 hours a day with flexible scheduling. If you need to postpone or reschedule your cleaning appointment, please inform us at least 2 hours in advance via phone or WhatsApp at <a href={siteConfig.phone.tel} class="text-sky-600 font-bold hover:underline">{siteConfig.phone.display}</a>.
          </p>
        </div>

        <div class="border-t border-slate-200 pt-6">
          <h3 class="text-xl font-bold text-slate-900 mb-3">6. Business Location & Contact</h3>
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 mt-4 space-y-2 text-sm text-slate-700">
            <p><strong>Service Provider:</strong> {siteConfig.name}</p>
            <p><strong>Office Address:</strong> {siteConfig.address.full}</p>
            <p><strong>Helpline:</strong> <a href={siteConfig.phone.tel} class="text-sky-600 font-bold hover:underline">{siteConfig.phone.display}</a></p>
            <p><strong>WhatsApp Support:</strong> <a href={siteConfig.phone.whatsappUrl} target="_blank" rel="noopener noreferrer" class="text-emerald-700 font-bold hover:underline">+{siteConfig.phone.whatsapp}</a></p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Closing Conversion CTA -->
  <ClosingCta
    title="Need Professional Tank Cleaning in Champapet?"
    description="Call 082477 35114 or connect via WhatsApp for direct service coordination."
  />
</BaseLayout>
