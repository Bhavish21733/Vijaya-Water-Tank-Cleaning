---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroInterior from '../components/HeroInterior.astro';
import WhatsAppHeroForm from '../components/WhatsAppHeroForm.astro';
import { siteConfig } from '../config/site';

const breadcrumbs = [
  { name: 'Contact Us' }
];
---

<BaseLayout
  title="Contact Vijaya Tank Cleaning | Champapet"
  description="Contact Vijaya Water Tank Cleaning Services in Champapet, Telangana. Call 082477 35114 or connect via WhatsApp for residential, commercial & industrial tank cleaning."
  breadcrumbs={breadcrumbs}
>
  <!-- Interior Hero with dark overlay, breadcrumbs, one H1, description, and exactly two CTAs -->
  <HeroInterior
    title='Contact <span class="text-[#00a6ff]">Vijaya Water Tank</span><br class="hidden sm:inline" /> Cleaning Services'
    description="Get in touch to discuss your water tank specifications, request an estimated quote, and arrange a cleaning appointment in Champapet."
    eyebrow="LOCAL & SAFE WATER SOLUTIONS"
    breadcrumbs={breadcrumbs}
    bgImage="/images/hero-about.webp"
    bgImageAlt="Customer enquiry and water tank service coordination in Champapet"
    isContactPage={true}
  />

  <!-- Main Contact Section -->
  <section class="py-16 sm:py-20 bg-white" id="enquiry">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left Column: Business Details & Google Map in Perfect Alignment -->
        <div class="lg:col-span-5 space-y-4 text-left">
          <div>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-sky-50 border border-sky-200 text-sky-700 text-xs font-bold uppercase tracking-wider mb-2">
              Business Contact
            </span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
              Get in Touch with Our Team
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 mt-1 leading-relaxed">
              Based in Harujanwada, Champapet. Available 24 hours for calls & WhatsApp enquiries.
            </p>
          </div>

          <!-- Phone & WhatsApp in ONE ROW -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <!-- Phone Card -->
            <a
              href={siteConfig.phone.tel}
              class="group bg-white rounded-2xl border border-slate-200 shadow-sm p-3.5 flex items-center gap-3 hover:border-sky-300 hover:shadow-md transition-all"
            >
              <div class="w-10 h-10 rounded-xl bg-sky-600 group-hover:bg-sky-500 text-white flex items-center justify-center shrink-0 shadow-sm transition-colors">
                <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"/>
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-[10px] font-bold text-sky-800 uppercase tracking-wider">Direct Call (24/7)</p>
                <p class="font-black text-sm sm:text-base text-slate-900 group-hover:text-sky-600 transition-colors truncate">
                  {siteConfig.phone.display}
                </p>
              </div>
            </a>

            <!-- WhatsApp Card -->
            <a
              href={siteConfig.phone.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group bg-white rounded-2xl border border-slate-200 shadow-sm p-3.5 flex items-center gap-3 hover:border-emerald-300 hover:shadow-md transition-all"
            >
              <div class="w-10 h-10 rounded-xl bg-[#25D366] group-hover:bg-[#20bd5a] text-white flex items-center justify-center shrink-0 shadow-sm transition-colors">
                <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.159.57 4.184 1.564 5.938l-1.564 5.718 5.864-1.538c1.701.927 3.652 1.458 5.727 1.458 6.627 0 12-5.373 12-12 0-6.627-5.373-12-12-12z"/>
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-[10px] font-bold text-emerald-800 uppercase tracking-wider">WhatsApp Quick Chat</p>
                <p class="font-black text-sm sm:text-base text-emerald-700 group-hover:text-emerald-800 transition-colors truncate">
                  Chat on WhatsApp →
                </p>
              </div>
            </a>
          </div>

          <!-- Physical Location Card -->
          <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-3.5 flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-slate-900 text-white flex items-center justify-center shrink-0 shadow-sm">
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-[10px] font-bold text-slate-700 uppercase tracking-wider">Physical Location</p>
              <p class="text-xs sm:text-sm font-extrabold text-slate-900 truncate">{siteConfig.address.street}, {siteConfig.address.locality}</p>
            </div>
          </div>

          <!-- Location Map (Champapet) -->
          <div class="space-y-2 pt-1">
            <div class="flex items-center justify-between">
              <h3 class="font-bold text-slate-900 text-xs uppercase tracking-wider">Location Map (Champapet)</h3>
              <a
                href={siteConfig.googleMaps.listingUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-bold text-sky-600 hover:underline inline-flex items-center gap-1"
              >
                <span>Open Google Maps</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>

            <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm h-56 sm:h-64 bg-slate-100 relative">
              <iframe
                title="Vijaya Water Tank Cleaning Services Location Map"
                src={siteConfig.googleMaps.embedUrl}
                width="100%"
                height="100%"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                class="w-full h-full"
              ></iframe>
            </div>
          </div>
        </div>

        <!-- Right Column: Instant WhatsApp Form from Homepage -->
        <div class="lg:col-span-7">
          <WhatsAppHeroForm class="shadow-xl" />
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
